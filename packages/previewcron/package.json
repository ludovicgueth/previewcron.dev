{
  "name": "previewcron",
  "version": "0.3.0",
  "description": "Trigger & test your Vercel cron jobs locally or on preview deployments",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludovicgueth/previewcron.dev"
  },
  "homepage": "https://previewcron.dev",
  "bugs": {
    "url": "https://github.com/ludovicgueth/previewcron.dev/issues"
  },
  "bin": {
    "previewcron": "./dist/cli/index.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "cp ./src/styles/previewcron.css ./dist/previewcron.css",
    "build:js": "tsup",
    "build": "bun run build:js && bun run build:css",
    "prepublishOnly": "bun run build",
    "lint": "echo \"No lint configured\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "vercel",
    "cron",
    "testing",
    "nextjs",
    "development"
  ],
  "author": "Ludovic Gueth",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
